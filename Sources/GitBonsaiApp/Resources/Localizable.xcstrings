        }
      }
    },
    "Local commits: %lld, new commits on %@: %lld. A fast-forward is not possible. Rebase puts the local commits on top of %@, merge joins both sides with a merge commit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokal %lld, auf %@ %lld neue Commits: Ein Fast-Forward ist nicht möglich. Rebase setzt die lokalen Commits auf %@, Merge führt beide Seiten mit einem Merge-Commit zusammen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Local commits: %1$lld, new commits on %2$@: %3$lld. A fast-forward is not possible. Rebase puts the local commits on top of %4$@, merge joins both sides with a merge commit."
          }
        }
      }
    },
    "Local has %@, %@ has %@. A fast-forward is not possible; nothing was changed. %@ is checked out in the worktree %@; it can be pulled there with merge or rebase." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokal %@, auf %@ %@. Ein Fast-Forward ist nicht möglich; geändert wurde nichts. %@ ist im Worktree %@ ausgecheckt; dort lässt es sich mit Merge oder Rebase pullen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Local has %1$@, %2$@ has %3$@. A fast-forward is not possible; nothing was changed. %4$@ is checked out in the worktree %5$@; it can be pulled there with merge or rebase."
          }
        }
      }
    },
    "Local has %@, %@ has %@. A fast-forward is not possible; nothing was changed. Check Out and Pull offers merge and rebase; resetting drops the local commits." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokal %@, auf %@ %@. Ein Fast-Forward ist nicht möglich; geändert wurde nichts. Auschecken und pullen bietet Merge und Rebase; Zurücksetzen verwirft die lokalen Commits."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Local has %1$@, %2$@ has %3$@. A fast-forward is not possible; nothing was changed. Check Out and Pull offers merge and rebase; resetting drops the local commits."
          }
        }
      }
    },
