{
  "sourceLanguage" : "en",
  "strings" : {
    "%@" : {
      "comment" : "Shown as is: git output, a commit subject or text localized elsewhere. Never translated.",
      "shouldTranslate" : false
    },
    "%@\n\nCommits that are only on this branch can then only be reached through the reflog." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nDie Commits, die nur auf diesem Branch liegen, sind danach nur noch über das Reflog erreichbar."
          }
        }
      }
    },
    "%@\n\nThe changes and untracked files in this folder will be lost." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nDie Änderungen und nicht versionierten Dateien in diesem Ordner gehen verloren."
          }
        }
      }
    },
    "%@ -m “WIP on <branch>: <HEAD>”" : {
      "comment" : "Tooltip: the git command with the message it writes; <branch> and <HEAD> are placeholders.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ -m „WIP auf <Branch>: <HEAD>“"
          }
        }
      }
    },
    "%@ and %@ have diverged" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ und %@ sind auseinandergelaufen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ and %2$@ have diverged"
          }
        }
      }
    },
    "%@ cannot be fast-forwarded. Resetting it to %@ drops %lld local commits; the reflog keeps them for a while." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ lässt sich nicht vorspulen. Beim Zurücksetzen auf %@ geht ein lokaler Commit verloren; das Reflog behält ihn noch eine Weile."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ lässt sich nicht vorspulen. Beim Zurücksetzen auf %@ gehen %lld lokale Commits verloren; das Reflog behält sie noch eine Weile."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ cannot be fast-forwarded. Resetting it to %@ drops %lld local commit; the reflog keeps it for a while."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ cannot be fast-forwarded. Resetting it to %@ drops %lld local commits; the reflog keeps them for a while."
                }
              }
            }
          }
        }
      }
    },
    "%@ can’t fold into the commit above: no commit stays above it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann nicht in den Commit darüber aufgehen: Über ihm bleibt keiner stehen."
          }
        }
      }
    },
    "%@ does not answer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ antwortet nicht"
          }
        }
      }
    },
    "%@ failed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fehlgeschlagen"
          }
        }
      }
    },
    "%@ failed after %@: %@" : {
      "comment" : "Status line: git command, duration, git's error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fehlgeschlagen nach %@: %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ failed after %2$@: %3$@"
          }
        }
      }
    },
    "%@ goes back to %@, where it was before the rebase (git reset --keep ORIG_HEAD). Local changes stay." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kommt zurück auf %@, den Stand vor dem Rebase (git reset --keep ORIG_HEAD). Lokale Änderungen bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ goes back to %2$@, where it was before the rebase (git reset --keep ORIG_HEAD). Local changes stay."
          }
        }
      }
    },
    "%@ goes back to %@, where it was before the rebase (git reset --keep ORIG_HEAD). Local changes stay.\n\nBranches moved along go back as well: %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kommt zurück auf %@, den Stand vor dem Rebase (git reset --keep ORIG_HEAD). Lokale Änderungen bleiben.\n\nMitgezogene Branches gehen ebenfalls zurück: %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ goes back to %2$@, where it was before the rebase (git reset --keep ORIG_HEAD). Local changes stay.\n\nBranches moved along go back as well: %3$@."
          }
        }
      }
    },
    "%@ has commits that %@ lacks. Pulling brings them in first; --force-with-lease overwrites them as long as %@ has not moved since the last fetch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ enthält Commits, die in %@ fehlen. Pullen holt sie zuerst; --force-with-lease überschreibt sie, solange sich %@ seit dem letzten Fetch nicht bewegt hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has commits that %2$@ lacks. Pulling brings them in first; --force-with-lease overwrites them as long as %3$@ has not moved since the last fetch."
          }
        }
      }
    },
    "%@ has diverged from %@" : {
      "comment" : "Status line; the arguments are a local branch and its upstream.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ weicht von %@ ab"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has diverged from %2$@"
          }
        }
      }
    },
    "%@ has moved since the last fetch. Fetch first and check what is new there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat sich seit dem letzten Fetch bewegt. Erst fetchen und prüfen, was dort neu ist."
          }
        }
      }
    },
    "%@ has no commit above it to fold into." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat keinen Commit über sich, in den er aufgehen könnte."
          }
        }
      }
    },
    "%@ has no upstream" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat keinen Upstream"
          }
        }
      }
    },
    "%@ has no upstream. The chosen remote branch becomes its upstream, then it is pulled from." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat keinen Upstream. Der gewählte Remote-Branch wird zum Upstream, danach wird von ihm gepullt."
          }
        }
      }
    },
    "%@ has uncommitted changes" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat nicht committete Änderungen"
          }
        }
      }
    },
    "%@ in progress" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ läuft"
          }
        }
      }
    },
    "%@ is checked out in the worktree %@ and can only be deleted together with it. The folder %@ will be removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist im Worktree %@ ausgecheckt und lässt sich nur zusammen mit ihm löschen. Der Ordner %@ wird entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is checked out in the worktree %2$@ and can only be deleted together with it. The folder %3$@ will be removed."
          }
        }
      }
    },
    "%@ is dropped" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird verworfen"
          }
        }
